{
  "name": "chainpulse",
  "version": "1.0.0",
  "private": true,
  "description": "Crypto infrastructure uptime and Polymarket odds, collected by GitHub Actions and served from GitHub Pages",
  "type": "module",
  "scripts": {
    "infra": "node scripts/infra.mjs",
    "markets": "node scripts/markets.mjs",
    "collect": "node scripts/infra.mjs && node scripts/markets.mjs",
    "demo": "node scripts/demo.mjs",
    "start": "node scripts/serve.mjs 8080"
  },
  "engines": {
    "node": ">=18"
  }
}
